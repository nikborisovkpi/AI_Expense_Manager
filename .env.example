# Frontend (no direct Supabase access)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend — Supabase (private Storage & PostgreSQL; no Supabase Auth / JWT / JWKS)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_RECEIPTS_BUCKET=receipts
SUPABASE_AVATARS_BUCKET=avatars
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_expense_manager

# Backend — OpenRouter (provider-agnostic: Claude / GPT / etc. under strict ZDR)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_CLASSIFICATION_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_FALLBACK_MODELS=openai/gpt-4.1-mini,openai/gpt-4.1
OPENROUTER_PROVIDER_ZDR=true
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_REQUIRE_PARAMETERS=true

# Backend — In-process Receipt Worker & Watchdog
RECEIPT_PROCESSING_TIMEOUT_SECONDS=120
RECEIPT_MAX_ATTEMPTS=3
RECEIPT_WORKER_POLL_INTERVAL_SECONDS=3
RECEIPT_WORKER_CONCURRENCY=1
RECEIPT_WATCHDOG_INTERVAL_SECONDS=30

# Backend — AI Safety & Daily Budgets
AI_DAILY_REQUEST_LIMIT=200
AI_DAILY_TOKEN_BUDGET=500000
AI_AGENT_MAX_STEPS=8
AI_TOOL_TIMEOUT_SECONDS=15
AI_RUN_TIMEOUT_SECONDS=60

# Backend — Observability (Logfire OR Langfuse; never log raw receipt text/images)
LOGFIRE_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Runtime
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
